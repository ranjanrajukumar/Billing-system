# Billing system API — configuration template.
#
# Copy to .env and fill in. Never commit the filled-in copy: .env is gitignored
# for a reason, and this file exists so that stays true.
#
# Everything marked REQUIRED IN PRODUCTION is checked at startup by
# src/config/env.js. A production process refuses to boot without them rather
# than failing later on a request nobody can explain.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# If the port is busy, how many times to retry before giving up.
PORT_RETRY_ATTEMPTS=10
# How long a shutdown waits for in-flight requests before forcing exit.
SHUTDOWN_GRACE_MS=10000

# ---------------------------------------------------------------------------
# Security — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
# Signs session tokens. Use 32+ random characters and keep it out of the repo.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out, which is the point after a leak.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Password hashing cost. Higher is slower to crack and slower to sign in.
BCRYPT_ROUNDS=12

# Which sites may call this API from a browser, comma-separated, no trailing
# slash. Falls back to CLIENT_URL. If neither is set the API accepts browser
# calls from ANY origin — fine on a laptop, not on the internet.
# e.g. CORS_ORIGINS=https://billing.example.com,https://admin.example.com
CORS_ORIGINS=
CLIENT_URL=http://localhost:5173

# Sign-up is closed once the first account exists; staff are added through the
# authenticated Users screen. Set true only if you genuinely want anyone who
# can reach this API to be able to create an account.
ALLOW_PUBLIC_REGISTRATION=false

# The account created on first boot. Set ADMIN_PASSWORD before the first run,
# or change the password immediately after signing in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Request budgets per window. The auth limiter is the brute-force brake and
# does not count successful sign-ins.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# mysql | mariadb | mssql | sqlite
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billingdb
DB_USER=root
DB_PASSWORD=
# A full connection URL, if you would rather not set the parts above.
DATABASE_URL=
# SQLite only.
DB_STORAGE=./database.sqlite

# SQL Server specifics.
DB_INSTANCE=
DB_DOMAIN=
DB_AUTH_TYPE=default
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# Create the database if it does not exist yet.
DB_CREATE_DATABASE=true

# Run migrations and seeds on boot.
AUTO_MIGRATE=true
# Let sync ALTER live tables to match the models. Convenient while developing;
# on production data prefer a reviewed migration to an automatic ALTER.
DB_SYNC_ALTER=true
# "false" makes a database failure fatal at boot instead of starting an API
# that answers 503 to everything. Recommended in production.
START_WITHOUT_DB=false

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# Set true to run without the scheduler — useful for a second instance that
# should not duplicate nightly work.
DISABLE_JOBS=false
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP=7
BACKUP_SCHEDULE=

# ---------------------------------------------------------------------------
# Notifications — optional; features degrade quietly when unset
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Company defaults, applied on first seed only
# ---------------------------------------------------------------------------
COMPANY_STATE=Tamil Nadu
